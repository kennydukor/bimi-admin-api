{
  "info": {
    "name": "Bimi Admin API",
    "description": "Bimi Phase 3 Admin Portal \u2014 full API surface (v1).\n\n**Auth:** run **Auth \u2192 Login** first; it sets an httpOnly session cookie that Postman's cookie jar sends automatically on every following request to {{base_url}}.\n\n**Onboarding (temp passwords \u2014 no email):** a Super Admin creates a user via **Users \u2192 Invite user**; the response returns a one-time `temp_password` (captured into the {{temp_password}} variable). The user logs in with it \u2014 `must_change_password` will be true \u2014 then calls **Auth \u2192 Change password**. A Super Admin can reissue a temp password via **Users \u2192 Reset password**.\n\n**Roles:** Users, dataset/row restore, row edit/delete, and recycle-bin management require a Super Admin session. Seeded Super Admin: demlabz@gmail.com / changeme123.\n\n**Legacy** contains the older email-based verify/reset endpoints, kept for compatibility but superseded by the temp-password flow.\n\nSet `base_url` (default http://localhost:8000). Fill table_name/row_id/dataset_id/user_id/batch_id from responses as you go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "table_name",
      "value": "federal_faac_allocation"
    },
    {
      "key": "row_id",
      "value": "1"
    },
    {
      "key": "dataset_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "batch_id",
      "value": ""
    },
    {
      "key": "temp_password",
      "value": ""
    },
    {
      "key": "current_user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Run first. Sets the session cookie. Response includes user.must_change_password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demlabz@gmail.com\",\n  \"password\": \"changeme123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.code === 200);",
                  "const b = pm.response.json();",
                  "if (b.user) {",
                  "  pm.collectionVariables.set('current_user_id', b.user.id);",
                  "  if (b.user.must_change_password === true) {",
                  "    console.log('This account must change its password: call Auth \u2192 Change password.');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "me"
              ]
            },
            "description": "Returns the logged-in user, including must_change_password."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "change-password"
              ]
            },
            "description": "The logged-in user sets a new password. Used on first login when must_change_password is true (uses the temp password as current_password), and any time after. 204 on success.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{temp_password}}\",\n  \"new_password\": \"my-new-strong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
