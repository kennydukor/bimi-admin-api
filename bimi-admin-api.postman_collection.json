            "description": "Creates an active user with a generated temp password. Response: {user, temp_password}. temp_password is captured into {{temp_password}} and shown once \u2014 hand it to the user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.admin@bimi.gov.ng\",\n  \"full_name\": \"New Admin\",\n  \"role\": \"regular_admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.temp_password) { pm.collectionVariables.set('temp_password', b.temp_password);",
                  "  console.log('Temp password:', b.temp_password); }",
                  "if (b.user && b.user.id) pm.collectionVariables.set('user_id', b.user.id);",
                  "if (b.id) pm.collectionVariables.set('user_id', b.id);"
                ]
              }
            }
          ]
