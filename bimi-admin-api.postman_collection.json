{
  "info": {
    "name": "Bimi Admin API",
    "description": "Bimi Phase 3 Admin Portal \u2014 full API surface (v1).\n\n**Auth:** run **Auth \u2192 Login** first; it sets an httpOnly session cookie that Postman's cookie jar sends automatically on every following request to {{base_url}}.\n\n**Roles:** Users, dataset/row restore, row edit/delete, and recycle-bin management require a Super Admin session. Seeded Super Admin: demlabz@gmail.com / changeme123.\n\nSet `base_url` (default http://localhost:8000). Fill table_name/row_id/dataset_id/user_id/batch_id from list responses as you go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "table_name",
      "value": "federal_faac_allocation"
    },
    {
      "key": "row_id",
      "value": "1"
    },
    {
      "key": "dataset_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "batch_id",
      "value": ""
    },
    {
      "key": "current_user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Run first. Sets the session cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demlabz@gmail.com\",\n  \"password\": \"changeme123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.code === 200);",
                  "const body = pm.response.json();",
                  "if (body.user) pm.collectionVariables.set('current_user_id', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user (me)",
          "request": {
